__pycache__/
*.pyc
.DS_Store

# A service is a bundle in runs/<date>/. Committed: the recording (32 kbps mono,
# the same bytes the site serves, so git stores it once), the deck, the bulletin,
# a manifest, the person's marks — and the three inputs every operator reads that
# cannot be regenerated faithfully: the transcript (Whisper gives a different one
# each run: 6159 words in September, 6238 from identical audio a month later), and
# the OCR'd lyrics and recognised notes (which need macOS Vision and homr).
# Everything else is derived from those and rebuilt on demand.
runs/**
!runs/
!runs/*/
!runs/*/audio.webm
!runs/*/deck.pptx
!runs/*/folder.pdf
!runs/*/folder.docx
!runs/*/bundle.json
!runs/*/marks.json
!runs/*/words.jsonl
!runs/*/lyrics.json
!runs/*/notes.json

# Set aside, never marked: not training bundles. July 19 was the earliest test
# service; September 6 was abandoned for poor audio.
runs/2026-07-19/
runs/2026-09-06/
